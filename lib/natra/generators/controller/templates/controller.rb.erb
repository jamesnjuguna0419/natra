class <%= class_name %> < ApplicationController
  get '/<%= controller_name %>' do
    json <%= model_class %>.order(:created_at)
  end

  get '/<%= controller_name %>/:id' do
    json find_<%= model_name %>
  end

  post '/<%= controller_name %>' do
    json <%= model_class %>.create!(<%= model_name %>_params), 201
  end

  patch '/<%= controller_name %>/:id' do
    record = find_<%= model_name %>
    record.update!(<%= model_name %>_params)
    json record
  end

  delete '/<%= controller_name %>/:id' do
    find_<%= model_name %>.destroy!
    halt 204
  end

  private

  def find_<%= model_name %>
    <%= model_class %>.find(params[:id])
  end

  def <%= model_name %>_params
<% if permitted_attributes.any? -%>
    json_params.slice(<%= permitted_attributes.map { |attribute| "'#{attribute}'" }.join(', ') %>)
<% else -%>
    json_params.slice(*(<%= model_class %>.column_names - %w(id created_at updated_at)))
<% end -%>
  end
end
